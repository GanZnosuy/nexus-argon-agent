# NEXUS - Gemini 4 Argon Autonomous Multi-Agent System Configuration
# Copy this file to .env and fill in your credentials

# Active Account (1, 2, or 3)
ACTIVE_ACCOUNT=1

# Google Account 1 (Gemini Web Cookies)
ACCOUNT1_SECURE_1PSID=
ACCOUNT1_SECURE_1PSIDTS=

# Google Account 2 (Optional for automatic quota rotation)
ACCOUNT2_SECURE_1PSID=
ACCOUNT2_SECURE_1PSIDTS=

# Google Account 3 (Optional for automatic quota rotation)
ACCOUNT3_SECURE_1PSID=
ACCOUNT3_SECURE_1PSIDTS=

# Optional: Official Google Gemini API Key (Fallback if web cookies expire)
GOOGLE_API_KEY=

# Optional: ElevenLabs TTS API Key
ELEVENLABS_API_KEY=

# Optional: YouTube Data API v3 Key
YOUTUBE_API_KEY=
